DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,127.0.0.1,localhost
DJANGO_SECURE_COOKIES=1
DJANGO_SECURE_SSL_REDIRECT=1

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ihatebackground
DB_USER=ihatebackground
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=db
DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_URL=redis://redis:6379/2

MAX_UPLOAD_MB=15
JOB_TTL_MINUTES=30
FREE_DAILY_LIMIT=1000
FREE_MAX_EDGE=1400
REMBG_MODEL=u2netp
REMBG_WORK_MAX_EDGE=1600
REMBG_ALPHA_MATTING=0
REMBG_POST_PROCESS_MASK=1

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_AMOUNT=900
PRO_ACCESS_HOURS=24
